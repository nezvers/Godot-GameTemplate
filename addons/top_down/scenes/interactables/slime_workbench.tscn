[ext_resource type="Texture2D" path="res://addons/top_down/assets/images/shadow.png" id="shadow"]
[ext_resource type="Script" path="res://game/scripts/balance/BalanceBinding.gd" id="binding"]
[ext_resource type="Script" path="res://addons/top_down/scripts/interactables/SlimeWorkbench.gd" id="script"]
[ext_resource type="Texture2D" path="res://addons/top_down/assets/images/misc/slime_workbench_32x24_strip2.png" id="tex"]
[ext_resource type="Resource" path="res://addons/top_down/resources/sounds/workbench_upgrade.tres" id="use"]
[ext_resource type="Resource" path="res://addons/top_down/resources/global_resources/slime_resource.tres" id="slime"]
[ext_resource type="Resource" path="res://addons/top_down/resources/ItemCollectionResource/weapon_inventory.tres" id="inventory"]
[ext_resource type="Resource" path="res://addons/top_down/resources/global_resources/weapon_upgrade_resource.tres" id="upgrades"]

[ext_resource type="Script" path="res://addons/great_games_library/nodes/Navigation/AstarShapeObstacle.gd" id="astar_obstacle"]
[ext_resource type="Resource" path="res://addons/top_down/resources/arena_resources/obstacle_astargrid_resource.tres" id="astar_grid"]

[sub_resource type="RectangleShape2D" id="body_shape"]
size = Vector2(30, 6)

[sub_resource type="CircleShape2D" id="area_shape"]
radius = 26.0

[node name="SlimeWorkbench" type="Node2D" node_paths=PackedStringArray("area", "prompt_label", "shake_node", "sprite")]
script = ExtResource("script")
area = NodePath("Area2D")
prompt_label = NodePath("PromptLabel")
shake_node = NodePath("Visuals")
action_resource = ExtResource("action")
player_reference = ExtResource("player")
sound_use = ExtResource("use")
sound_denied = ExtResource("denied")
slime_resource = ExtResource("slime")
weapon_inventory = ExtResource("inventory")
weapon_upgrade_resource = ExtResource("upgrades")
sprite = NodePath("Visuals/Sprite2D")

[node name="Shadow" type="Sprite2D" parent="."]
modulate = Color(0, 0, 0, 0.35)
scale = Vector2(2.50, 1)
texture = ExtResource("shadow")

[node name="Visuals" type="Node2D" parent="."]

[node name="Sprite2D" type="Sprite2D" parent="Visuals"]
position = Vector2(0, -10)
texture = ExtResource("tex")
hframes = 2

[node name="StaticBody2D" type="StaticBody2D" parent="."]

[node name="CollisionShape2D" type="CollisionShape2D" parent="StaticBody2D"]
position = Vector2(0, -3)
shape = SubResource("body_shape")

[node name="AstarShapeObstacle" type="Node" parent="." node_paths=PackedStringArray("body")]
script = ExtResource("astar_obstacle")
astargrid_resource = ExtResource("astar_grid")
body = NodePath("../StaticBody2D")

[node name="Area2D" type="Area2D" parent="."]
scale = Vector2(1, 0.5)
collision_layer = 0
collision_mask = 0

[node name="CollisionShape2D" type="CollisionShape2D" parent="Area2D"]
shape = SubResource("area_shape")

[node name="PromptLabel" type="Label" parent="."]
z_index = 10
offset_left = -60.0
offset_top = -30.0
offset_right = 60.0
offset_bottom = -21.0
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_colors/font_outline_color = Color(0, 0, 0, 1)
theme_override_constants/outline_size = 2
theme_override_font_sizes/font_size = 6
text = "[E] Use"
horizontal_alignment = 1

[node name="BalanceBinding" type="Node" parent="."]
script = ExtResource("binding")
