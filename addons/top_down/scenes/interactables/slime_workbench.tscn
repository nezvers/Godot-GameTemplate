[gd_scene format=3]

[ext_resource type="Resource" path="res://addons/top_down/resources/global_resources/action_resource.tres" id="action"]
[ext_resource type="Resource" path="res://addons/top_down/resources/ReferenceNodeResources/player_reference.tres" id="player"]
